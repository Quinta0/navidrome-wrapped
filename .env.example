# At least one of ListenBrainz / Last.fm
LB_USER=
LB_TOKEN=
LASTFM_USER=
LASTFM_KEY=

# Navidrome (optional, enables durations, genres, library stats, slide audio and covers)
ND_URL=http://192.168.1.10:4533
ND_USER=
ND_PASS=

# Optional
# REFRESH=both     # or monthly / yearly: a recap per month, per year (Jan 1 - Dec 31), or both
# THEME_SEED=123456  # keep a look you like (each run prints its seed); unset = new look every run
